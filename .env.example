DATABASE_URL=
REDIS_URL=

PORT=4000
# Must be the API's real public URL once deployed (Railway) - used to build
# the /unsubscribe link inside every sent email.
PUBLIC_API_URL=http://localhost:4000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SES_FROM_ADDRESS=
# Optional: ties sends to an SES configuration set so bounce/complaint/delivery
# events publish to the SNS topic the /sns/ses-events webhook listens on.
SES_CONFIGURATION_SET=
# Optional shared secret appended as ?secret=... to the SNS subscription URL -
# SNS has no built-in auth for HTTP(S) endpoints, so this keeps the webhook
# from being wide open to anyone who finds it.
SNS_WEBHOOK_SECRET=
# S3 bucket for the PDF Library (Documents feature) - same AWS account/region
# as SES, separate bucket + scoped IAM policy on the same IAM user.
S3_DOCUMENTS_BUCKET=

# Google Sheets access is via a service account (not a public API key) so the
# client's lead sheet never has to be made link-shareable. Share the sheet with
# GOOGLE_SERVICE_ACCOUNT_EMAIL as a Viewer to grant access.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
SHEET_ID=
SHEET_RANGE=Sheet1!A:H

IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

JWT_SECRET=

# Used only by `npm run prisma:seed` to create the single login user.
ADMIN_EMAIL=
ADMIN_PASSWORD=

DEFAULT_DAILY_SEND_CAP=100
DEFAULT_BUSINESS_HOURS_START=9
DEFAULT_BUSINESS_HOURS_END=17
DEFAULT_TIMEZONE_FALLBACK=America/New_York
