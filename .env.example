DATABASE_URL=
REDIS_URL=

PORT=4000
# Must be the API's real public URL once deployed (Railway) - used to build
# the /unsubscribe link inside every sent email.
PUBLIC_API_URL=http://localhost:4000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SES_FROM_ADDRESS=

# Google Sheets access is via a service account (not a public API key) so the
# client's lead sheet never has to be made link-shareable. Share the sheet with
# GOOGLE_SERVICE_ACCOUNT_EMAIL as a Viewer to grant access.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
SHEET_ID=
SHEET_RANGE=Sheet1!A:H

IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

JWT_SECRET=

# Used only by `npm run prisma:seed` to create the single login user.
ADMIN_EMAIL=
ADMIN_PASSWORD=

DEFAULT_DAILY_SEND_CAP=100
DEFAULT_BUSINESS_HOURS_START=9
DEFAULT_BUSINESS_HOURS_END=17
DEFAULT_TIMEZONE_FALLBACK=America/New_York
