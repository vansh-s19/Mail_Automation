generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id                String   @id @default(uuid())
  name              String?
  title             String?
  company           String?
  phone             String?
  domain            String?
  locationRaw       String?  @map("location_raw")
  resolvedTimezone  String?  @map("resolved_timezone")
  industry          String?
  email             String   @unique
  customFields      Json?    @map("custom_fields")
  isSuppressed      Boolean  @default(false) @map("is_suppressed")
  sourceRowRef      String?  @map("source_row_ref")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  listMembers       ContactListMember[]
  campaignContacts  CampaignContact[]

  @@map("contacts")
}

model ContactList {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members   ContactListMember[]

  @@map("contact_lists")
}

model ContactListMember {
  id            String   @id @default(uuid())
  contactListId String   @map("contact_list_id")
  contactId     String   @map("contact_id")

  contactList   ContactList @relation(fields: [contactListId], references: [id])
  contact       Contact     @relation(fields: [contactId], references: [id])

  @@unique([contactListId, contactId])
  @@map("contact_list_members")
}

model Template {
  id        String   @id @default(uuid())
  name      String
  subject   String
  bodyHtml  String   @map("body_html")
  bodyText  String?  @map("body_text")
  createdAt DateTime @default(now()) @map("created_at")

  steps     SequenceStep[]
  automations SequenceStepAutomation[]

  @@map("templates")
}

model Campaign {
  id            String   @id @default(uuid())
  name          String
  status        String   @default("draft")
  sendingRules  Json?    @map("sending_rules")
  createdAt     DateTime @default(now()) @map("created_at")

  steps             SequenceStep[]
  campaignContacts  CampaignContact[]

  @@map("campaigns")
}

model SequenceStep {
  id              String   @id @default(uuid())
  campaignId      String   @map("campaign_id")
  stepOrder       Int      @map("step_order")
  templateId      String   @map("template_id")
  delayDays       Int      @default(0) @map("delay_days")
  delayHours      Int      @default(0) @map("delay_hours")
  // Overrides the template's own subject for just this step - lets one
  // reusable template serve different subject lines per step/campaign
  // without forking the template itself. Null = use template.subject.
  subjectOverride String?  @map("subject_override")
  // Overrides Campaign.sendingRules.businessHoursStart for just this step's
  // send time. Null = inherit the campaign-wide business-hours-start.
  sendHour        Int?     @map("send_hour")
  // Optional PDF sent as an attachment with this step - reused across
  // campaigns/steps from the PDF Library rather than re-uploaded each time.
  attachmentId    String?  @map("attachment_id")

  campaign    Campaign     @relation(fields: [campaignId], references: [id])
  template    Template     @relation(fields: [templateId], references: [id])
  attachment  PdfDocument? @relation(fields: [attachmentId], references: [id])

  dailyQueueEntries DailySendQueue[]
  emailSends        EmailSend[]
  automations       SequenceStepAutomation[]

  @@unique([campaignId, stepOrder])
  @@map("sequence_steps")
}

model PdfDocument {
  id        String   @id @default(uuid())
  name      String
  s3Key     String   @map("s3_key")
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")

  steps     SequenceStep[]

  @@map("pdf_documents")
}

model CampaignContact {
  id            String   @id @default(uuid())
  campaignId    String   @map("campaign_id")
  contactId     String   @map("contact_id")
  currentStepId String?  @map("current_step_id")
  state         String   @default("pending")
  enrolledAt    DateTime @default(now()) @map("enrolled_at")

  campaign      Campaign @relation(fields: [campaignId], references: [id])
  contact       Contact  @relation(fields: [contactId], references: [id])

  dailyQueueEntries DailySendQueue[]
  emailSends        EmailSend[]

  @@unique([campaignId, contactId])
  @@map("campaign_contacts")
}

model DailySendQueue {
  id                String   @id @default(uuid())
  campaignContactId String   @map("campaign_contact_id")
  sequenceStepId    String   @map("sequence_step_id")
  targetDate        DateTime @map("target_date") @db.Date
  status            String   @default("pending_review")

  campaignContact   CampaignContact @relation(fields: [campaignContactId], references: [id])
  sequenceStep      SequenceStep    @relation(fields: [sequenceStepId], references: [id])

  @@map("daily_send_queue")
}

model EmailSend {
  id                 String    @id @default(uuid())
  campaignContactId  String    @map("campaign_contact_id")
  sequenceStepId     String    @map("sequence_step_id")
  scheduledFor       DateTime  @map("scheduled_for")
  currentStatus      String    @default("queued") @map("current_status")
  providerMessageId  String?   @map("provider_message_id")
  attemptCount       Int       @default(0) @map("attempt_count")

  campaignContact    CampaignContact @relation(fields: [campaignContactId], references: [id])
  sequenceStep       SequenceStep    @relation(fields: [sequenceStepId], references: [id])

  events             EmailEvent[]
  automationFollowUps AutomationFollowUp[]

  @@unique([campaignContactId, sequenceStepId])
  @@map("email_sends")
}

model EmailEvent {
  id          String   @id @default(uuid())
  emailSendId String   @map("email_send_id")
  eventType   String   @map("event_type")
  eventData   Json?    @map("event_data")
  occurredAt  DateTime @default(now()) @map("occurred_at")

  emailSend   EmailSend @relation(fields: [emailSendId], references: [id])

  @@map("email_events")
}

model SuppressionList {
  id       String   @id @default(uuid())
  email    String   @unique
  reason   String
  addedAt  DateTime @default(now()) @map("added_at")

  @@map("suppression_list")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

// Engagement automation: a rule attached to a sequence step ("opened, no
// reply -> send a different template after N hours"), not a campaign-level
// toggle - keeps the model extensible to future triggers (link-clicked,
// no-open-resend, replied-stop) without another schema change.
model SequenceStepAutomation {
  id                String   @id @default(uuid())
  sequenceStepId    String   @map("sequence_step_id")
  // "opened_no_reply" is the only trigger implemented today; the column
  // supports future values without a migration.
  triggerType       String   @map("trigger_type")
  triggerDelayHours Int      @map("trigger_delay_hours")
  actionTemplateId  String   @map("action_template_id")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  sequenceStep      SequenceStep @relation(fields: [sequenceStepId], references: [id])
  actionTemplate    Template     @relation(fields: [actionTemplateId], references: [id])

  followUps         AutomationFollowUp[]

  @@map("sequence_step_automations")
}

// Deliberately a separate table from EmailSend, not a nullable column on it -
// EmailSend's own unique(campaignContactId, sequenceStepId) constraint is the
// hard duplicate-send guard for the normal sequence and must stay untouched.
model AutomationFollowUp {
  id                 String   @id @default(uuid())
  automationRuleId   String   @map("automation_rule_id")
  // The original step-send whose "opened" event triggered this follow-up.
  triggerEmailSendId String   @map("trigger_email_send_id")
  status             String   @default("scheduled") @map("status") // scheduled -> sent/failed/cancelled
  scheduledFor       DateTime @map("scheduled_for")
  providerMessageId  String?  @map("provider_message_id")
  createdAt          DateTime @default(now()) @map("created_at")

  automationRule     SequenceStepAutomation @relation(fields: [automationRuleId], references: [id])
  triggerEmailSend   EmailSend              @relation(fields: [triggerEmailSendId], references: [id])

  // Hard dedup guard: the same rule can only ever schedule once per triggering
  // send - mirrors EmailSend's own uniqueness pattern.
  @@unique([automationRuleId, triggerEmailSendId])
  @@map("automation_follow_ups")
}
